# FOLIO New Materials — Example Configuration
# Copy this file to config.ini and fill in your values.
#
# SECURITY: Run the generate script from *outside* this directory so that
# config.ini is never accidentally served or exposed by a web server.
# Example cron entry (script lives at /opt/folio-new-books):
#   0 6 * * * cd /opt && python folio-new-books/generate.py --config folio-new-books/config.ini

[folio]
# Okapi gateway URL — no trailing slash
base_url = https://api-example.folio.ebsco.com
# FOLIO tenant ID used in x-okapi-tenant header
tenant = fs00001006
# Account with read access to orders and inventory
username = your_username
password = your_password
# Optional: FOLIO Edge API base URL (leave blank to skip RTAC lookups).
# When edge_api AND edge_api_key are set, the generator fetches live
# holdings (call numbers, locations, statuses) via /prod/rtac/folioRTAC
# for every item.  Works with consortia where one instance has copies
# at multiple libraries.
edge_api =
edge_api_key =

[eds]
# EDS OpenURL path component — the "4e4lys" in /c/4e4lys/openurl
db_id = 4e4lys
# EDS catalog database code — the "cat09206a" in id=ebsco:cat09206a:...
catalog_db = cat09206a
# Access-number prefix that identifies your FOLIO instance in EDS
# Example: scf.oai.edge.fivecolleges.folio.ebsco.com.fs00001006
an_prefix = scf.oai.edge.example.folio.ebsco.com.fs00001006
# How to format the UUID in the EDS id parameter: dots | dashes
an_separator = dots
# Strategy for building EDS deep links:
#   openurl  (default) — OpenURL with the FOLIO access number as the
#                        primary id and rft.isbn / rft.oclc as supplementary
#                        identifiers.  EDS tries each in order, so new
#                        records that aren't AN-indexed yet still resolve
#                        via ISBN or OCLC.  Single click to the catalog
#                        record when resolution succeeds.
#   search             — Direct EDS Discovery search URL keyed on ISBN,
#                        OCLC, or title.  Always lands on a results page
#                        (never a 404), at the cost of an extra click for
#                        the patron to pick the right record.  Useful when
#                        the openurl resolver is unreliable for your
#                        institution's record types.
link_strategy = openurl

[google]
# Cover images are fetched via the free Google Books viewapi (no API key required).
# Images are fetched at generation time (not at view time) using ISBN or OCLC numbers.
# Set to false to disable Google Books cover-image lookups.
enabled = true

[tmdb]
# TMDB (The Movie Database) poster lookup — useful for DVD/video materials.
# Obtain a free API key at https://www.themoviedb.org/settings/api
# Leave blank to disable TMDB poster lookup.
api_key =
# Poster image size: w185, w342, w500, w780, original (default: w500)
poster_size = w500

[output]
# Days to look back when no explicit --start/--end is given
days = 30
# File path for the generated HTML (relative to where you run the script)
output_file = output/new-materials.html
# Text shown in the browser tab and page heading
title = New Materials
# Your library's display name
institution_name = Your Library
# URL to a logo image (leave blank to show no logo)
logo_url =
# Brand colours — must be valid CSS colour values
primary_color = #003366
accent_color = #ffffff
# Default view when the user has no saved preference: grid | table
default_view = grid
# How to render multi-holding items (RTAC must be configured to populate this):
#   none     — never show holdings info on cards
#   compact  — show just the copy count: "3 copies"
#   summary  — show the first call number + library, with "+N more" if more (default)
#   detailed — show every holding as a list
holdings_display = summary
# When true, write one HTML page per material type (e.g. new-books.html,
# new-dvds.html) instead of a single combined page with a format dropdown.
# Useful for staff who want to share a per-format list independently.
# Uses [material_types] when set; otherwise discovers types from the data.
pages_per_type = false
# Path to a rotating log file for cron-job troubleshooting.  10 MB × 5
# backups by default.  Set to "no" / "none" / empty to disable file logging.
log_file = logs/folio-new-books.log

[material_types]
# Map material-type UUID to the label shown in the format dropdown.
#
# IMPORTANT: leave this section empty (or omit it) to fetch ALL material
# types from FOLIO.  When empty, the generator calls /material-types to
# discover the names automatically — the dropdown is populated from the
# actual types that appear in the results.
#
# Add entries here only when you want to *restrict* the listing to specific
# formats (e.g. only Books and DVDs).
#
# Example:
# 2d72aa13-2451-41fe-afc7-b3dc7c131389 = Books
# faa0cd0a-e408-4b57-acff-1c3f9171723d = DVD
# a2c91e87-6bab-44d6-8adb-1fd39a8bf9d6 = Music CD

[subject_groups]
# Optional: group items by high-level subject area.
#
# Two modes available:
#
# 1. MANUAL GROUPS — list group names and keywords here.  Each line is:
#       Group Name = comma-separated keywords (case-insensitive)
#    Items are placed in the FIRST group whose keyword appears in any of
#    their FOLIO subject headings; items that match no group are listed
#    as "Other".  This gives the most curated dropdown.
#
# 2. LCC GROUPING — set `lcc_grouping = true` (and leave the section
#    otherwise empty).  Each item is classified by the first letter of its
#    call number against the Library of Congress top-level classes (e.g.
#    QA76 → Q → "Science").  Reliable for libraries that use LCC;
#    libraries on Dewey or local schemes will see most items in "Other".
#
# Leave this section empty AND lcc_grouping unset to disable subject grouping.
#
# Examples:
#
# lcc_grouping = true
#
# Engineering = engineering, computer, programming, mathematics, physics
# Humanities  = literature, philosophy, history, art, music
# Sciences    = biology, chemistry, geology, ecology, astronomy
